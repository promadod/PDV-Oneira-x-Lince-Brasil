# Copie para .env e preencha os valores.
# Nunca commite o arquivo .env.

# Django
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Banco — Docker Compose (serviço "db")
POSTGRES_DB=pdv
POSTGRES_USER=pdv
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Fora do Docker (Postgres nativo local), use por exemplo:
# POSTGRES_HOST=127.0.0.1

# CORS — lista separada por vírgula (vazio = só same-origin em produção)
CORS_ALLOWED_ORIGINS=

# Produção Contabo (exemplo):
# DEBUG=False
# ALLOWED_HOSTS=oneirasistemas.com.br,www.oneirasistemas.com.br,207.244.248.73,localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://oneirasistemas.com.br,https://www.oneirasistemas.com.br
# CORS_ALLOWED_ORIGINS=https://oneirasistemas.com.br,https://www.oneirasistemas.com.br
# Antes do HTTPS (acesso só por IP em HTTP):
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False
# Depois do HTTPS:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# CSRF_TRUSTED_ORIGINS=https://oneirasistemas.com.br,https://www.oneirasistemas.com.br
